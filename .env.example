# Copy this file to .env and fill in values for the features you want.

# --- Timezone ---
# Your local timezone (used for the digest "today" calculation and display)
TZ=America/New_York

# --- Digest delivery ---
# Time of day to send the daily digest, in 24h HH:MM format, in TZ above.
DIGEST_TIME=07:00

# Where to send the digest
DIGEST_EMAIL_TO=shermanlegos@gmail.com

# --- Email provider (pick one) ---
# Option A: Resend (recommended — free tier covers personal use)
# Sign up at resend.com, create an API key, verify a sender domain or use onboarding@resend.dev
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Option B: Plain SMTP (e.g. Gmail with an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- SMS (optional, via Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
DIGEST_SMS_TO=

# --- ntfy.sh push (optional, free, no account required) ---
# Pick an unguessable topic name (the topic IS the only secret). Then install
# the ntfy app and subscribe to the same topic.
# Example: NTFY_TOPIC=kcal-7a3f9b2c-daily
NTFY_TOPIC=
# Override only if you self-host or use ntfy.sh paid tiers
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# --- App behavior ---
# How many days ahead to fetch
FETCH_DAYS_AHEAD=180
# How many days into the past to keep (lets you scroll the calendar
# backwards and still see final scores instead of a blank month)
FETCH_DAYS_BEHIND=90
# How often to auto-refresh data (minutes)
REFRESH_INTERVAL_MIN=30
# Look up each game's Kalshi prediction market during refresh and show the
# link in the event popover. Public API, no key needed. Set false to skip.
KALSHI_LINKS=true
